# AI Arena — local env template. Copy to .env.local and fill in real values.
# .env.local is gitignored (never commit secrets — the repo is public).

# --- Azure OpenAI (Foundry Chat Agent) ---
# Resource endpoint with the v1 GA path appended.
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/openai/v1/
AZURE_OPENAI_API_KEY=<your-key>
# The model *deployment* name you created in Foundry (not a URL).
MODEL_ENDPOINT=gpt-5-mini

# --- Cost safety ---
# Flip to "true" to instantly pause every demo without redeploying.
KILL_SWITCH=false

# NOTE: the daily-budget counter uses Netlify Blobs, which is auto-provisioned
# when deployed on Netlify — no credentials needed. For local runs use
# `netlify dev` so the Blobs store is available (the middleware fails open if not).
