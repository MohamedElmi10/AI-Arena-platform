# AI Arena — local env template. Copy to .env.local and fill in real values.
# .env.local is gitignored (never commit secrets — the repo is public).

# --- Azure OpenAI (Foundry Chat Agent) ---
# Resource endpoint with the v1 GA path appended.
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/openai/v1/
AZURE_OPENAI_API_KEY=<your-key>
# The model *deployment* name you created in Foundry (not a URL).
MODEL_ENDPOINT=gpt-5-mini

# --- Cost safety ---
# Flip to "true" to instantly pause every demo without redeploying.
KILL_SWITCH=false

# NOTE: the daily-budget counter uses Netlify Blobs, which is auto-provisioned
# when deployed on Netlify — no credentials needed. For local runs use
# `netlify dev` so the Blobs store is available (the middleware fails open if not).

# --- Multi-Agent Orchestration (T-014) ---
# Foundry project endpoint (shared with the other agent-creating tiles).
PROJECT_ENDPOINT=https://<your-resource>.services.ai.azure.com/api/projects/<your-project>
# MUST be a NON-reasoning chat deployment (gpt-4o / gpt-4.1-mini), NOT gpt-5-mini:
# a reasoning model breaks the System.LastMessage handoff. See build.py header.
MULTI_AGENT_MODEL=gpt-4o
# The Foundry workflow name the app (and build.py smoke test) invokes.
MULTI_AGENT_WORKFLOW=trip-planner

# --- Content Understanding (T-022) ---
# Foundry resource endpoint (https://<resource>.services.ai.azure.com/).
CU_ENDPOINT=https://<your-resource>.services.ai.azure.com/
# Optional. Omit to use DefaultAzureCredential (az login + Cognitive Services
# User role) — preferred; keys are test-only. Runtime keeps keys server-side.
CU_KEY=<your-key>
# Model deployments CU maps to (defaults shown; must exist in the resource).
CU_COMPLETION_MODEL=gpt-4.1
CU_EMBEDDING_MODEL=text-embedding-3-large

# --- Document Intelligence (T-023) ---
# Resource endpoint (https://<resource>.cognitiveservices.azure.com/).
DOCINTEL_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/
# Resource key (portal -> Keys and Endpoint). Server-side only; never the browser.
DOCINTEL_KEY=<your-key>

# --- MCP Agent (Hosted + Own) (T-012) ---
# TWO Foundry agents — one wired to each MCP server. The tile's hosted/own
# toggle picks which. Both must be set or that mode 503s ("demo isn't available").
MCP_AGENT_HOSTED_NAME=<foundry agent connected to GitHub's hosted MCP server>
MCP_AGENT_OWN_NAME=<foundry agent connected to AI Arena's own MCP server>

# Token gating the read-only /api/status counts endpoint (set a random string in Netlify env)
STATUS_TOKEN=
